format: xrdf
format_version: 2.0

default_joint_positions:
  shoulder_pan_joint: -1.57
  shoulder_lift_joint: -1.57
  elbow_joint: -1.57
  wrist_1_joint: -1.57
  wrist_2_joint: 1.57
  wrist_3_joint: 0.0

cspace:
  joint_names:
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["tool0"]

world_collision:
  geometry: "ur7e_collision_spheres"

self_collision:
  geometry: "ur7e_self_collision_spheres"
  ignore:
    shoulder_link: [ "upper_arm_link" ]
    upper_arm_link: [ "forearm_link" ]
    forearm_link: [ "wrist_1_link" ]
    wrist_1_link: [ "wrist_2_link" ]
    wrist_2_link: [ "wrist_3_link" ]
    wrist_3_link: [ "tool0", "robotiq_base" ]
    tool0: [ "wrist_3_link", "pinch_center", "robotiq_base" ]
    robotiq_base: [ "tool0", "robotiq_right_finger", "robotiq_left_finger" ]
    robotiq_right_finger: [ "robotiq_base", "robotiq_right_pad" ]
    robotiq_left_finger: [ "robotiq_base", "robotiq_left_pad" ]

geometry:
  ur7e_collision_spheres:
    spheres:
      shoulder_link:
        - center: [ 0.0, 0.0, -0.09 ]
          radius: 0.062
        - center: [ 0.0, 0.0, -0.03 ]
          radius: 0.062
        - center: [ 0.0, 0.0, 0.02 ]
          radius: 0.060
      upper_arm_link:
        - center: [ 0.0, -0.08, 0.0 ]
          radius: 0.063
        - center: [ 0.0, -0.02, 0.0 ]
          radius: 0.063
        - center: [ 0.0, 0.0, 0.045 ]
          radius: 0.055
        - center: [ 0.0, 0.0, 0.125 ]
          radius: 0.055
        - center: [ 0.0, 0.0, 0.205 ]
          radius: 0.055
        - center: [ 0.0, 0.0, 0.285 ]
          radius: 0.055
        - center: [ 0.0, 0.0, 0.365 ]
          radius: 0.055
      forearm_link:
        - center: [ 0.0, 0.04, 0.0 ]
          radius: 0.058
        - center: [ 0.0, 0.12, 0.0 ]
          radius: 0.058
        - center: [ 0.0, 0.0, 0.055 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.130 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.205 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.280 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.355 ]
          radius: 0.042
      wrist_1_link:
        - center: [ 0.0, -0.005, 0.0 ]
          radius: 0.042
        - center: [ 0.0, 0.055, 0.0 ]
          radius: 0.042
        - center: [ 0.0, 0.115, 0.0 ]
          radius: 0.042
      wrist_2_link:
        - center: [ 0.0, 0.0, 0.0 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.055 ]
          radius: 0.042
        - center: [ 0.0, 0.0, 0.100 ]
          radius: 0.042
        - center: [ 0.0, -0.015, 0.100 ]
          radius: 0.042
        - center: [ 0.0, 0.045, 0.100 ]
          radius: 0.042
      wrist_3_link:
        - center: [ 0.0, 0.06, 0.0 ]
          radius: 0.045
        - center: [ 0.0, 0.10, 0.0 ]
          radius: 0.045
      tool0:
        - center: [ 0.0, 0.0, 0.0 ]
          radius: 0.03
        - center: [ 0.0, 0.0, 0.035 ]
          radius: 0.040
        - center: [ 0.0, 0.0, 0.095 ]
          radius: 0.035
      pinch_center:
        - center: [ 0.0, 0.0, 0.0 ]
          radius: 0.020
      robotiq_base:
        - center: [ -0.025, 0.0, -0.018 ]
          radius: 0.045
        - center: [ 0.025, 0.0, -0.018 ]
          radius: 0.045
        - center: [ -0.025, 0.0, 0.018 ]
          radius: 0.045
        - center: [ 0.025, 0.0, 0.018 ]
          radius: 0.045
      robotiq_right_finger:
        - center: [ 0.0, 0.0, -0.025 ]
          radius: 0.021
        - center: [ 0.0, 0.0, 0.0 ]
          radius: 0.021
        - center: [ 0.0, 0.0, 0.024 ]
          radius: 0.021
      robotiq_left_finger:
        - center: [ 0.0, 0.0, -0.025 ]
          radius: 0.021
        - center: [ 0.0, 0.0, 0.0 ]
          radius: 0.021
        - center: [ 0.0, 0.0, 0.024 ]
          radius: 0.021
      robotiq_right_pad:
        - center: [ 0.0, 0.0, -0.016 ]
          radius: 0.018
        - center: [ 0.0, 0.0, 0.016 ]
          radius: 0.018
      robotiq_left_pad:
        - center: [ 0.0, 0.0, -0.016 ]
          radius: 0.018
        - center: [ 0.0, 0.0, 0.016 ]
          radius: 0.018
  ur7e_self_only_collision_spheres:
    spheres:
      shoulder_link:
        - center: [ 0.0, 0.0, -0.1 ]
          radius: 0.097
        - center: [ 0.0, 0.01, 0.0 ]
          radius: 0.107
  ur7e_self_collision_spheres:
    clone: ["ur7e_collision_spheres", "ur7e_self_only_collision_spheres"]
