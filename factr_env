#!/usr/bin/env bash
# Activate the factr_teleop_ur7e environment:
#   1) ROS 2 Jazzy underlay
#   2) the repo's uv virtualenv (.venv)
#   3) the colcon workspace overlay (install/setup.bash)
#
# Usage:
#   ./factr_env          run it -> drops you into a shell with everything active
#   source ./factr_env   activate in your CURRENT shell instead of a subshell
#
# Exit the spawned shell with `exit` (or Ctrl-D) to return to your normal shell.

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source /opt/ros/jazzy/setup.bash
source "$REPO/.venv/bin/activate"
source "$REPO/install/setup.bash"

# ROS launches the node via its installed entry-point script, whose shebang is the
# *resolved* interpreter (/usr/bin/python3.12, because uv's .venv/bin/python is a
# symlink to it). A process started that way does NOT load the venv's site-packages,
# so venv-only deps (ur_rtde / rtde_control, pyzmq) and the editable dynamixel_sdk
# would be missing. Bridge them onto PYTHONPATH so the system interpreter finds them.
# (.pth files in PYTHONPATH dirs are not processed, so the editable dynamixel_sdk
# source dir is added explicitly.)
PYVER="$("$REPO/.venv/bin/python" -c 'import sys;print(f"python{sys.version_info.major}.{sys.version_info.minor}")')"
export PYTHONPATH="$REPO/.venv/lib/$PYVER/site-packages:$REPO/src/factr_teleop/factr_teleop/dynamixel/python/src${PYTHONPATH:+:$PYTHONPATH}"

echo "FACTR env active: ROS 2 Jazzy + .venv + workspace overlay  ($REPO)"

# If executed (not sourced), keep the environment alive in an interactive shell.
if ! (return 0 2>/dev/null); then
    exec "${SHELL:-bash}" -i
fi
