#!/usr/bin/env bash
# Activate FACTR with ROS 2 Jazzy plus the factr_teleop conda environment.
#
# Usage:
#   source ./factr_conda_env
#
# Source this file so the environment stays active in your current shell.

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source /home/leo/anaconda3/etc/profile.d/conda.sh
conda activate factr_teleop

# Source ROS after activating conda so ROS Python paths are not cleared by conda
# activation hooks.
source /opt/ros/jazzy/setup.bash

if [ -f "$REPO/install/setup.bash" ]; then
  source "$REPO/install/setup.bash"
fi

echo "FACTR conda env active: ROS 2 ${ROS_DISTRO:-unknown} + conda factr_teleop ($REPO)"
